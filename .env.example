# Copy to .env (git-ignored). Used by docker-compose.
POSTGRES_PASSWORD=banksync
# openssl rand -base64 32
BS2_ENCRYPTION_MASTER_KEY=
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://banksync.api
AUTH0_ALLOWED_EMAIL=you@example.com
# Alternative to the email: your Auth0 user id (sub), e.g. auth0|abc123
AUTH0_ALLOWED_SUBJECT=
AUTH0_ADMIN_SUBJECT=
PUBLIC_ORIGIN=http://localhost:8080
ENABLEBANKING_APP_KID=
# Sent as psu-ip-address (Argenta requires it). Use the host's LAN address; the container's is auto-detected otherwise.
PSU_IP_ADDRESS=
OPENAI_API_KEY=
OPENAI_MODEL=
# Expiry / re-authorization mails. Leave SMTP_HOST empty to disable.
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
